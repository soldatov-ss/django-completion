# Django manage.py bash completion — generated by django-completion

# ---------------------------------------------------------------------------
# Cache lookup — walks up from $PWD until it finds the cache file
# ---------------------------------------------------------------------------

_django_manage_find_cache() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/.django-completion-cache.json" ]]; then
            echo "$dir/.django-completion-cache.json"
            return
        fi
        dir="$(dirname "$dir")"
    done
}

_django_complete_with_helper() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local cache_file
    cache_file="$(_django_manage_find_cache)"
    [[ -z "$cache_file" ]] && return 0

    local words_json
    words_json=$(printf '%s\n' "${COMP_WORDS[@]}" | python3 -c '
import json, sys
print(json.dumps(sys.stdin.read().splitlines()))
' 2>/dev/null)
    [[ -z "$words_json" ]] && return 0

    local candidates
    candidates=$(python3 -m django_completion._complete \
        --cache "$cache_file" \
        --words-json "$words_json" \
        --cword "$COMP_CWORD" \
        --format bash 2>/dev/null)
    COMPREPLY=($(compgen -W "$candidates" -- "$cur"))
}

# ---------------------------------------------------------------------------
# Completion for: manage.py <tab>
# ---------------------------------------------------------------------------

_django_manage_completion() {
    _django_complete_with_helper
}

# ---------------------------------------------------------------------------
# Completion for: python manage.py <tab>  (and python3 manage.py <tab>)
# ---------------------------------------------------------------------------

_django_python_completion() {
    _django_complete_with_helper
}

# ---------------------------------------------------------------------------
# Register completions
# ---------------------------------------------------------------------------

# Path-like ./manage.py as the first shell word needs a default completion hook,
# which is intentionally out of scope; wrapped forms such as python ./manage.py work.
complete -F _django_manage_completion manage.py
complete -o default -F _django_python_completion python python3 uv
