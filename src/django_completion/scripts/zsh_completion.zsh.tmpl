# Django manage.py zsh completion — generated by django-completion

# ---------------------------------------------------------------------------
# Cache lookup — walks up from $PWD until it finds the cache file
# ---------------------------------------------------------------------------

_django_manage_find_cache() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        [[ -f "$dir/.django-completion-cache.json" ]] && { echo "$dir/.django-completion-cache.json"; return; }
        dir="$(dirname "$dir")"
    done
}

_django_complete_with_helper() {
    local tag="$1"
    local description="$2"

    local cache_file
    cache_file="$(_django_manage_find_cache)"
    [[ -z "$cache_file" ]] && return 1

    local words_json
    words_json=$(printf '%s\n' "${words[@]}" | python3 -c '
import json, sys
print(json.dumps(sys.stdin.read().splitlines()))
' 2>/dev/null)
    [[ -z "$words_json" ]] && return 1

    local cword=$(( CURRENT - 1 ))
    local -a candidates
    candidates=(${(f)"$(python3 -m django_completion._complete \
        --cache "$cache_file" \
        --words-json "$words_json" \
        --cword "$cword" \
        --format zsh 2>/dev/null)"})
    (( ${#candidates[@]} == 0 )) && return 1

    _describe -t "$tag" "$description" candidates
}

# ---------------------------------------------------------------------------
# Completion for: manage.py <tab>
# ---------------------------------------------------------------------------

_django_manage() {
    if (( CURRENT == 2 )); then
        _django_complete_with_helper commands "django command"
    elif (( CURRENT >= 3 )); then
        _django_complete_with_helper arguments "django argument"
    fi
}

# ---------------------------------------------------------------------------
# Completion for: python manage.py <tab>  (and python3 manage.py <tab>)
# ---------------------------------------------------------------------------

_django_python_manage() {
    # Only activate when manage.py appears in already-typed words.
    local manage_pos=-1 i
    for (( i=2; i<CURRENT; i++ )); do
        if [[ "${words[$i]}" == *manage.py ]]; then
            manage_pos=$i
        fi
    done

    if (( manage_pos == -1 )); then
        _default
        return
    fi

    local relative_current=$(( CURRENT - manage_pos ))

    if (( relative_current == 1 )); then
        _django_complete_with_helper commands "django command"
    elif (( relative_current >= 2 )); then
        _django_complete_with_helper arguments "django argument"
    fi
}

# ---------------------------------------------------------------------------
# Register completions
# ---------------------------------------------------------------------------

compdef _django_manage manage.py
compdef _django_python_manage python python3 uv
